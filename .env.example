# Copy this file to `.env` and fill in the keys for the provider(s) you use.
# CodeSwarm loads this automatically (via python-dotenv) at startup.
# You only need a key for the provider you actually select.

# --- BytePlus ModelArk (default) ---
# Create a key in the BytePlus ModelArk console. ModelArk exposes an
# OpenAI-compatible API, so CodeSwarm talks to it with the openai SDK.
ARK_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Gemini ---
# Uses Gemini's OpenAI-compatibility endpoint (…/v1beta/openai/).
GEMINI_API_KEY=


# ===========================================================================
# Deepfake Detection app (deepfake_detector/) -- BytePlus LLM App Firewall
# ---------------------------------------------------------------------------
# Separate from the CodeSwarm keys above. These power the deepfake detection
# web app / CLI. They stay in `.env` (git-ignored) and are never logged.
# ===========================================================================

# Access Key ID and Secret Access Key of your BytePlus account.
# BytePlus IAM > Access key management: https://console.byteplus.com/iam/keymanage
BYTEPLUS_LLM_FIREWALL_AK=
BYTEPLUS_LLM_FIREWALL_SK=

# AppID of the asset you created with Integration=SDK and Scenario=Deepfake.
BYTEPLUS_DEEPFAKE_APPID=

# Instance region: ap-southeast-1 (Asia Pacific / Johor) or cn-hongkong.
BYTEPLUS_DEEPFAKE_REGION=ap-southeast-1

# Optional. Full endpoint override. If empty it is derived from the region as
# https://{region}.sdk.access-bp.llm-shield.omni-shield.ai
BYTEPLUS_DEEPFAKE_ENDPOINT=

# Optional. SDK request timeout in seconds (default 50).
BYTEPLUS_DEEPFAKE_TIMEOUT=50
